# ============================================================
# oc-discord — .env 템플릿
#  사용법: 이 파일을 같은 폴더의 '.env' 로 복사한 뒤 값을 채운다.
#      Copy-Item .env.example .env
#  .env 는 .gitignore 에 등록되어 있으므로 커밋되지 않는다.
# ============================================================

# ---- Discord 애플리케이션 (필수) ------------------------------
# Discord Developer Portal -> General Information
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=

# Developer Portal -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# ---- 보안 allowlist (필수) ------------------------------------
# 봇에게 작업을 지시할 수 있는 Discord 사용자 ID
# 개발자 모드 -> 사용자 우클릭 -> ID 복사
DISCORD_OWNER_USER_ID=

# ---- 채널 제한 / 트리거 (선택) --------------------------------
# 대화 범위는 channel-policy.json 이 우선한다(비워 둬도 됨).
# DISCORD_GUILD_ID=
# 역할 멘션으로도 봇을 깨우려면 역할 ID (콤마 구분)
# DISCORD_MENTION_ROLE_IDS=

# ---- 작업 폴더 루트 (선택) ------------------------------------
# 이 루트에서 "폴더명(lowercase) == 채널명(lowercase)" 인 폴더를 그 채널의 기본 cwd 로 쓴다.
# 우선순위: channel-cwd.json override > 정확히 일치 > 구분자무시 일치 > 유일한 접미사 일치.
# 비워 두면 D:\Coding.
# CHANNEL_FOLDER_MATCHING_DIR=D:\Coding

# ---- 동작 조정 (선택) -----------------------------------------
# 툴 승인 정책: auto(전부 승인) | ask(채널 버튼으로 질문, 기본) | deny(전부 거부)
# OCD_PERMISSIONS=ask
# 버튼 응답 대기 시간(초). 초과 시 거부.
# OCD_PERMISSION_TIMEOUT_SEC=180
# 진행 중 답변 실시간 편집 / 편집 간격(ms)
# OCD_STREAM=true
# OCD_STREAM_EDIT_MS=1300
# Discord 메시지 1개 길이(2000 하드리밋 - 여유)
# OCD_MAX_CHUNK=1900
# 툴 호출 상태 줄 표시
# OCD_SHOW_TOOLS=true
# 유휴 opencode 프로세스 자동 종료(분). 0 이면 유지.
# OCD_IDLE_SHUTDOWN_MIN=30
# 동시에 유지하는 opencode 프로세스 최대 개수
# OCD_MAX_AGENTS=8
# 멘션 없이도 반응하도록 강제(true/false). 미설정이면 channel-policy.json 을 따른다
# OCD_REQUIRE_MENTION=
# /cmd 셸 명령 타임아웃(초)
# OCD_CMD_TIMEOUT_SEC=60
# 모든 세션에서 쓸 모델을 강제 고정한다(비우면 채널별 /model 값 사용).
# 지정 시 /model 로 변경할 수 없다. 예: opencode-go/deepseek-v4.1-flash
# OCD_MODEL=
# 모든 프롬프트에 덧붙일 추가 지침(선택). 장시간 작업 타임아웃 안내 등.
# OCD_EXTRA_INSTRUCTIONS=
# 기동 시 슬래시 커맨드 자동 등록
# OCD_DEPLOY_COMMANDS=false
# 로그 레벨(debug|info|warn|error)
# OCD_LOG_LEVEL=info

# ---- 실행 파일 / 루트 (선택) ----------------------------------
# opencode 실행 파일 경로(미지정 시 자동 해석)
# OPENCODE_BIN=
# 리포 루트(미지정 시 .env 를 찾아 상위로 탐색)
# OCD_ROOT=
